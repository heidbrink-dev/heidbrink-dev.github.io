---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex gap-2">
      {tags.map((tag) => (
        <a
          class="py-1 px-2 rounded bg-white border-black border text-black hover:no-underline hover:scale-110 transition-transform"
          href={`/tags/${tag}`}
        >
          {tag}
        </a>
      ))}
    </div>
  )
}
