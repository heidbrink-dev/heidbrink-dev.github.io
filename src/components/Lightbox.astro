---

---

<dialog
  id="lightbox"
  class="m-auto backdrop:bg-black/90 rounded-2xl"
  closedby="any"
>
  <div class="flex flex-col">
    <form method="dialog" class="self-end">
      <button class="text-4xl cursor-pointer p-4">×</button>
    </form>
    <div class="flex flex-row my-auto">
      <button
        class="px-4 text-4xl cursor-pointer"
        onclick="showPreviousImage()"
      >
        ‹
      </button>
      <div class="flex flex-col">
        <img
          id="lightbox-image"
          class="rounded-2xl max-w-10/12 max-h-10/12 cursor-default m-auto"
        />
        <span id="lightbox-caption" class="p-2 text-center text-sm"></span>
      </div>
      <button class="px-4 text-4xl cursor-pointer" onclick="showNextImage()">
        ›
      </button>
    </div>
  </div>
</dialog>

<script is:inline>
  const images = document.querySelectorAll(".blog img");
  const lightboxDialog = document.querySelector("#lightbox");
  const lightboxImage = lightboxDialog.querySelector("#lightbox-image");
  const lightboxCaption = lightboxDialog.querySelector("#lightbox-caption");

  let currentIndex = -1;

  images.forEach((image) => {
    image.addEventListener("click", (event) => openLightbox(event.target));
  });

  function openLightbox(image) {
    if (!lightboxDialog.open) {
      lightboxDialog.showModal();

      for (let i = 0; i < images.length; i++) {
        if (image == images[i]) {
          currentIndex = i;
        }
      }
    }

    lightboxImage.src = image.src;
    lightboxImage.alt = image.alt;
    lightboxCaption.innerHTML = image.alt;
  }

  function showPreviousImage() {
    currentIndex--;
    if (currentIndex < 0) {
      currentIndex = images.length - 1;
    }

    openLightbox(images[currentIndex]);
  }

  function showNextImage() {
    currentIndex++;
    if (currentIndex >= images.length) {
      currentIndex = 0;
    }

    openLightbox(images[currentIndex]);
  }
</script>
